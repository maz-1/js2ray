{
  "name": "js2ray",
  "version": "4.0.0-dev.0",
  "description": "Embeddable pure JavaScript proxy runtime with explicit lifecycle and direct Duplex dialing",
  "main": "index.js",
  "bin": {
    "js2ray": "cli/index.js"
  },
  "keywords": [
    "vmess",
    "nodejs",
    "v2ray",
    "javascript",
    "xray",
    "x-ui",
    "vpn",
    "proxy",
    "protocol"
  ],
  "scripts": {
    "start": "node cli/index.js",
    "test": "node --test --test-timeout=15000 test/*.test.js",
    "check": "node scripts/check.js",
    "check:config": "node cli/index.js check examples/direct.json && node cli/index.js check examples/vless-wss-client.json && node cli/index.js check examples/vless-xhttp-client.json && node cli/index.js check examples/vless-vision-client.json && node cli/index.js check examples/vless-reality-client.json && node cli/index.js check examples/combined.json",
    "test:interop": "node --test --test-concurrency=1 --test-timeout=15000 test/interop/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc -p tsconfig.json",
    "test:package": "node scripts/verify-package.js",
    "test:stability": "node scripts/stability.js",
    "test:stability:extensions": "node scripts/extension-stability.js",
    "test:stability:transports": "node scripts/transport-stability.js",
    "test:tools": "node scripts/install-reference-cores.js"
  },
  "author": "seezaara",
  "license": "MIT",
  "homepage": "https://github.com/seezaara/js2ray",
  "repository": {
    "type": "git",
    "url": "https://github.com/seezaara/js2ray.git"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.mjs"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "cli",
    "config",
    "runtime",
    "transports",
    "adapters",
    "reverse",
    "routing",
    "dns",
    "geodata",
    "core",
    "protocols",
    "examples",
    "docs",
    "LICENSE",
    "README.md",
    "DEVELOPMENT_PLAN.zh-CN.md"
  ],
  "devDependencies": {
    "@types/node": "24.10.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "undici": "7.30.0"
  }
}
