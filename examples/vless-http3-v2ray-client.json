{
  "inbounds": [
    { "listen": "127.0.0.1", "port": 1080, "protocol": "socks", "settings": { "auth": "noauth" } }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "proxy.example",
            "port": 443,
            "users": [{ "id": "d342d11e-d424-4583-b36e-524ab1f0afa4", "encryption": "none" }]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": { "serverName": "proxy.example", "alpn": ["h3"] },
        "xhttpSettings": { "path": "/xhttp/", "mode": "stream-up" }
      }
    }
  ]
}
