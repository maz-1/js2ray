{
  "inbounds": [{ "protocol": "socks", "networks": [{ "address": "127.0.0.1", "port": 1080 }] }],
  "outbounds": [
    {
      "protocol": "vless",
      "users": [{ "id": "d342d11e-d424-4583-b36e-524ab1f0afa4", "encryption": "none" }],
      "networks": [
        {
          "type": "xhttp",
          "address": "proxy.example",
          "port": 443,
          "option": {
            "httpVersion": "3",
            "mode": "stream-up",
            "path": "/xhttp/",
            "tls": { "serverName": "proxy.example" }
          }
        }
      ]
    }
  ]
}
